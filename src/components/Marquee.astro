---
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<div class="marquee" data-marquee aria-hidden="true">
  <div class="marquee__track" data-marquee-track>
    {[0, 1].map(() => (
      <div class="marquee__group">
        {items.map((it) => (
          <span class="marquee__item">
            {it}
            <svg viewBox="0 0 24 24"><path d="M3.5 13.2c2.1 1.4 3.7 3.2 5 5.3C11.6 12 15.6 7.3 20.8 4" /></svg>
          </span>
        ))}
      </div>
    ))}
  </div>
</div>

<style>
  .marquee {
    position: relative;
    overflow: hidden;
    padding-block: clamp(1.1rem, 2.4vw, 1.8rem);
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }
  .marquee__track {
    display: flex;
    width: max-content;
  }
  .marquee__group {
    display: flex;
    flex: none;
  }
  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: clamp(1.2rem, 2.6vw, 2.4rem);
    padding-right: clamp(1.2rem, 2.6vw, 2.4rem);
    font-family: var(--serif);
    font-size: clamp(1.6rem, 1rem + 2.6vw, 3.4rem);
    font-weight: 330;
    font-variation-settings: "SOFT" 60, "WONK" 0;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .marquee__item:nth-child(even) {
    font-style: italic;
    font-variation-settings: "SOFT" 100, "WONK" 1;
  }
  .marquee__item svg {
    width: 0.62em;
    height: 0.62em;
    fill: none;
    stroke: var(--pen);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
