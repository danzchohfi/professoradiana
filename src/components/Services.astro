---
import type { Content } from "../i18n/content";
interface Props {
  c: Content;
}
const { c } = Astro.props;
const s = c.services;
---

<section class="services" id="aulas" aria-labelledby="aulas-title">
  <div class="wrap">
    <div class="services__head">
      <p class="eyebrow" data-reveal>{s.eyebrow}</p>
      <h2 class="display h2" id="aulas-title" data-reveal>{s.title}</h2>
    </div>

    <ol class="services__list">
      {s.items.map((it, i) => (
        <li class="service" data-reveal>
          <span class="service__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="service__title serif">{it.title}</h3>
          <div class="service__body">
            <p class="service__text">{it.text}</p>
            <p class="service__meta">{it.meta}</p>
          </div>
          <svg class="service__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .services {
    padding-block: clamp(4.5rem, 10vw, 8rem);
    background: var(--paper);
  }
  .services__head {
    display: grid;
    gap: 0.4rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  .services__head .h2 {
    max-width: 16ch;
  }
  .services__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .service {
    position: relative;
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 0.4rem 1rem;
    padding-block: clamp(1.6rem, 3.4vw, 2.6rem);
    border-bottom: 1px solid var(--line);
  }
  .service::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.8s var(--ease);
  }
  .service:hover::before {
    transform: scaleX(1);
  }
  .service__n {
    padding-top: 0.55rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    transition: color 0.4s var(--ease);
  }
  .service:hover .service__n {
    color: var(--pen-ink);
  }
  .service__title {
    margin: 0;
    font-size: clamp(1.7rem, 1.1rem + 2.2vw, 3rem);
    font-weight: 340;
    line-height: 1.05;
    letter-spacing: -0.02em;
    transition: transform 0.6s var(--ease);
  }
  .service:hover .service__title {
    transform: translateX(0.4rem);
  }
  .service__body {
    grid-column: 2;
  }
  .service__text {
    margin: 0.6rem 0 0.8rem;
    max-width: 52ch;
    color: #2c3445;
  }
  .service__meta {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 560;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .service__arrow {
    display: none;
  }
  @media (min-width: 900px) {
    .services__head {
      grid-template-columns: 1fr 2fr;
      align-items: end;
    }
    .services__head .eyebrow {
      align-self: start;
      margin-top: 1rem;
    }
    .service {
      grid-template-columns: 4rem minmax(0, 1.05fr) minmax(0, 1fr) 2.5rem;
      gap: 2rem;
      align-items: start;
    }
    .service__body {
      grid-column: auto;
    }
    .service__text {
      margin-top: 0.5rem;
    }
    .service__arrow {
      display: block;
      width: 2rem;
      height: 2rem;
      margin-top: 0.6rem;
      fill: none;
      stroke: var(--ink);
      stroke-width: 1.4;
      stroke-linecap: round;
      stroke-linejoin: round;
      opacity: 0.25;
      transition:
        opacity 0.4s var(--ease),
        transform 0.6s var(--ease),
        stroke 0.4s;
    }
    .service:hover .service__arrow {
      opacity: 1;
      stroke: var(--pen);
      transform: rotate(45deg);
    }
  }
</style>
