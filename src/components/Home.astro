---
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Marquee from "./Marquee.astro";
import Manifesto from "./Manifesto.astro";
import Services from "./Services.astro";
import Method from "./Method.astro";
import About from "./About.astro";
import Bridge from "./Bridge.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import { content, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}
const c = content[Astro.props.lang];
---

<Base c={c}>
  <Header c={c} />
  <main id="conteudo">
    <Hero c={c} />
    <Marquee items={c.marquee} />
    <Manifesto c={c} />
    <Services c={c} />
    <Method c={c} />
    <About c={c} />
    <Bridge c={c} />
    <Contact c={c} />
  </main>
  <Footer c={c} />
</Base>

<script>
  import { start } from "../scripts/motion";
  void start();
</script>
