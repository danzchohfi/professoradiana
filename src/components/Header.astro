---
import Logo from "./Logo.astro";
import type { Content } from "../i18n/content";

interface Props {
  c: Content;
}
const { c } = Astro.props;
---

<header class="header" data-header>
  <div class="wrap header__inner">
    <Logo href={c.path} label={`Professora Diana — ${c.lang === "pt" ? "início" : "home"}`} />

    <nav class="header__nav" aria-label={c.lang === "pt" ? "Seções" : "Sections"}>
      <a href="#aulas">{c.nav.services}</a>
      <a href="#metodo">{c.nav.method}</a>
      <a href="#sobre">{c.nav.about}</a>
    </nav>

    <div class="header__actions">
      <a class="header__lang" href={c.alt.path} hreflang={c.alt.lang === "pt" ? "pt-BR" : "en"} lang={c.alt.lang === "pt" ? "pt-BR" : "en"} aria-label={c.alt.aria}>
        <span aria-hidden="true">{c.lang.toUpperCase()}</span>
        <span class="header__lang-sep" aria-hidden="true">/</span>
        <span aria-hidden="true" class="header__lang-alt">{c.alt.label}</span>
      </a>
      <a class="btn btn--pen header__cta" href="#contato" data-magnetic>{c.nav.contact}</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--paper);
    transition:
      transform 0.5s var(--ease),
      color 0.4s var(--ease);
  }
  .header::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(244, 239, 230, 0.86);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .header:global(.is-solid) {
    color: var(--ink);
  }
  .header:global(.is-solid)::before {
    opacity: 1;
  }
  .header:global(.is-hidden) {
    transform: translateY(-110%);
  }
  .header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.75rem;
    padding-top: env(safe-area-inset-top);
  }
  .header__nav {
    display: none;
    gap: 2.2rem;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .header__nav a {
    position: relative;
    text-decoration: none;
    padding: 0.4rem 0;
  }
  .header__nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1.5px;
    background: var(--pen);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease);
  }
  .header__nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .header__lang {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    padding-inline: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
  }
  .header__lang-sep {
    opacity: 0.35;
  }
  .header__lang-alt {
    opacity: 0.55;
    transition: opacity 0.3s;
  }
  .header__lang:hover .header__lang-alt {
    opacity: 1;
  }
  .header__cta {
    min-height: 2.75rem;
    padding: 0.6rem 1.2rem;
    font-size: 0.92rem;
  }
  @media (min-width: 900px) {
    .header__nav {
      display: flex;
    }
  }
  @media (max-width: 380px) {
    .header :global(.logo__text small) {
      display: none;
    }
  }
</style>
